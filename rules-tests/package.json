{
  "name": "anychat-firestore-rules-tests",
  "private": true,
  "description": "Firestore security rules tests against the local emulator (demo project, no credentials).",
  "scripts": {
    "test": "firebase emulators:exec --project demo-anychat --only firestore \"node --test\"",
    "test:only": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.34.2"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    },
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    }
  }
}
